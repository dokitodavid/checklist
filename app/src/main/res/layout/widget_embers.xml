<?xml version="1.0" encoding="utf-8"?>
<!-- O ProgressBar indeterminado é a única forma de um widget animar sozinho de forma contínua:
     o launcher roda o vetor animado sem o app precisar atualizar o widget. -->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:indeterminate="true"
    android:indeterminateDrawable="@drawable/embers_animated"
    android:indeterminateTint="#F2A541"
    android:indeterminateTintMode="src_in"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:maxWidth="4000dp"
    android:maxHeight="4000dp"
    android:importantForAccessibility="no"
    android:clickable="false"
    android:focusable="false" />
