<?xml version="1.0" encoding="utf-8"?>
<!-- O ProgressBar indeterminado é a forma de um widget animar sozinho de forma contínua:
     o launcher inicia a animação quadro a quadro (drawable/embers_animated.xml) sem o app
     precisar atualizar o widget. A tinta branca em "multiply" neutraliza a cor do tema,
     preservando as cores das brasas. -->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:indeterminate="true"
    android:indeterminateDrawable="@drawable/embers_animated"
    android:indeterminateTint="#FFFFFFFF"
    android:indeterminateTintMode="multiply"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:maxWidth="4000dp"
    android:maxHeight="4000dp"
    android:importantForAccessibility="no"
    android:clickable="false"
    android:focusable="false" />
